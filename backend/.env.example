DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
# Required for http://localhost OAuth in dev (oauthlib). Set to 0 only if using HTTPS locally.
OAUTHLIB_INSECURE_TRANSPORT=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Google Console (use 5173 so session cookies work with the React dev server)
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/gmail/callback/
FRONTEND_URL=http://localhost:5173

# Optional: smarter triage via Cursor SDK (https://cursor.com/dashboard/integrations)
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

# Indeed search (Gmail syntax). Combined with EMAIL_SEARCH_DAYS automatically.
EMAIL_GMAIL_QUERY=from:indeed OR from:indeedemail
# 1 = last 24 hours, 7 = week, 30 = month (default)
EMAIL_SEARCH_DAYS=30
# all = whole mailbox (recommended); inbox = INBOX label only
EMAIL_SEARCH_SCOPE=all
EMAIL_FETCH_MAX=100
# Set true only if you get non-Indeed false positives
EMAIL_STRICT_SENDER_FILTER=false

# Tune what Indeed mail counts as important
JOB_TITLE=Software Engineer
JOB_COMPANY=Indeed
JOB_SENDER_DOMAINS=indeed.com,indeedemail.com,indeed.co.uk
JOB_KEYWORDS=interview,application,employer,viewed your resume,job alert,offer,hiring,assessment

EMAIL_FETCH_MAX=40
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
